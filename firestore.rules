rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 老師／管理員：在 admins 名單（文件 ID 是 Google 帳號 email）裡的登入帳號
    function isStaff() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // 作答紀錄（attempts）只能由伺服器計分寫入：Cloud Function functions/index.js 用管理員權限寫，不經過這份規則。
    // 學生的瀏覽器不能新增、修改、刪除任何作答紀錄（以前可以直接寫，學生能改分數）。

    // 老師後台「成績」直接讀 Firestore：用 collection group 查詢所有 attempts
    match /{path=**}/attempts/{attemptId} {
      allow read: if isStaff();
    }

    // 老師後台儲存時寫入的公開設定與題目（學生網站只讀）。
    // 寫入者有兩個：老師的瀏覽器（登入後直接寫，學生幾乎立刻收到）與 Apps Script（專案擁有者權限，
    // 存進試算表後再寫一次做最後確認）。
    match /public/{doc} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }

    // 課文理解、句型練習的完整題目（含答案、解析）：只有老師讀寫（後台編輯）；公開版在 public/content_<單元>（拿掉答案，js/answers.js）。
    // 伺服器計分用管理員權限讀；學生交卷後由伺服器把完整內容給這位學生檢討
    match /secure/{doc} {
      allow read: if isStaff();
      allow delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }

    // 名單由 Apps Script 從試算表 teachers 分頁自動同步（syncStaff_），不要在主控台手動改；登入的人只能讀自己那一筆（用來判斷是不是老師）
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // 學生帳本：key = SHA-256(班級|座號|姓名)。知道 key 才讀得到，不能列出全部。
    // 只有老師能建立（匯入名單），學生用班級、座號、姓名算出 key 來確認身分。
    match /vault/{key} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['cls', 'seat', 'name', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if isStaff();

      // 學生自己的測驗紀錄：伺服器計分後寫入；學生登入後讀回（確認做過哪些單元）
      match /attempts/{attemptId} {
        allow read: if true;
        allow write: if false;
      }

      // meta：伺服器計分的限頻紀錄；sessions：句型練習正式測驗每題作答的紀錄（第一次作答就鎖定）。只有伺服器讀寫
      match /meta/{doc} {
        allow read, write: if false;
      }
      match /sessions/{doc} {
        allow read, write: if false;
      }

      // 已完成檢討的單元（文件 ID 是單元 id）；完成檢討後才能開始複習
      match /reviews/{unitId} {
        allow read: if true;
        allow create, update: if exists(/databases/$(database)/documents/vault/$(key))
          && request.resource.data.keys().hasOnly(['unit', 'at'])
          && request.resource.data.unit == unitId
          && request.resource.data.at == request.time;
        allow delete: if false;
      }
    }

    // 依班級整理的資料：給老師在主控台瀏覽，網站不讀取
    match /classes/{cls}/seats/{seat} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['cls', 'seat', 'name', 'updatedAt']);
      allow delete: if isStaff();

      // 作答紀錄由伺服器計分後寫入，只有老師能讀
      match /units/{unitId}/attempts/{attemptId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // private：伺服器之間用的設定（例如轉送試算表的通關密語），任何人都不能讀寫
    match /private/{doc} {
      allow read, write: if false;
    }
  }
}
