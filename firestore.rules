rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 學生基本資料：班級+座號當文件 ID，只能新增/更新自己這筆，不能刪除、不能公開讀取
    match /students/{id} {
      allow read: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['cls', 'seat', 'name', 'updatedAt']) &&
        request.resource.data.cls is string && request.resource.data.cls.size() <= 8 &&
        request.resource.data.seat is string && request.resource.data.seat.size() <= 4 &&
        request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    // 成績：attemptId 當文件 ID，天生防止重複；不開放讀取、不能刪除
    match /scores/{id} {
      allow read: if false;
      allow create: if
        request.resource.data.keys().hasAll(['cls', 'seat', 'name', 'unit', 'attemptId']) &&
        request.resource.data.attemptId is string && request.resource.data.attemptId.size() <= 64;
      // 更新時只能覆蓋「同一筆」（attemptId 不能被改成別人的），防止竄改別的紀錄
      allow update: if request.resource.data.attemptId == resource.data.attemptId;
      allow delete: if false;
    }
  }
}
