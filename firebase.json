{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".claude/**",
      ".impeccable/**",
      ".firebase/**",
      ".git/**",
      "PRODUCT.md",
      "**/node_modules/**",
      "apps-script/**",
      "tools/**",
      "README.md",
      "docs/**",
      "videos/**",
      "database.rules.json",
      "firestore.indexes.json",
      "firestore.rules",
      "*.zip",
      "*.log",
      "functions/**"
    ],
    "headers": [
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://*.firebasedatabase.app https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://asia-east1-eng-3385e.cloudfunctions.net https://*.googleapis.com https://script.google.com https://script.googleusercontent.com https://www.gstatic.com https://eng-3385e.firebaseapp.com https://*.firebasedatabase.app wss://*.firebasedatabase.app https://*.run.app http://127.0.0.1:8765 https://www.google.com/recaptcha/; frame-src https://accounts.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://eng-3385e.firebaseapp.com https://*.firebaseapp.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self' https://sites.google.com"
          }
        ]
      }
    ],
    "redirects": [{ "source": "/monitor.html", "destination": "/admin.html#live", "type": 301 }],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "node tools/stamp-version.mjs"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "node tools/copy-site-to-functions.mjs"
      ]
    }
  ]
}
